# Use a long random value outside local development.
AUTH_VAULT_JWT_SECRET=replace-with-a-long-random-secret
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
AUTH_VAULT_ENCRYPTION_KEY=replace-with-a-fernet-key
AUTH_VAULT_DATABASE_URL=sqlite:///./auth_vault.db
# AUTH_VAULT_DATABASE_URL=postgresql+psycopg://auth_vault:auth_vault@db:5432/auth_vault
AUTH_VAULT_CORS_ORIGINS=["http://localhost:3000"]
